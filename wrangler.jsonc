// Cloudflare Workers settings for running the site with OpenNext.
// The site's database is Cloudflare D1, bound as DB (unused until accounts arrive). Its ID isn't secret; any secrets go in the dashboard, never here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "offset-website",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "offset", "database_id": "c8712e60-f24e-4e79-a964-7f20b189a18a" }
  ],
  // Preview builds of pull requests use their own database, so tests never touch real accounts (Ian, 2026-10-13).
  "previews": {
    // TEST BRANCH ONLY: never merge. Points the test copy at Pledge's sandbox.
    "vars": { "PLEDGE_API_HOST": "https://api-staging.pledge.to" },
    "d1_databases": [{ "binding": "DB", "database_name": "offset-preview", "database_id": "bf541dbf-55b9-48b8-8410-9f3973660891" }]
  },
  // Once a day, sends any "your next month is ready" emails that are due (custom-worker.ts).
  "triggers": { "crons": ["0 15 * * *"] },
  "observability": { "enabled": true }
}
