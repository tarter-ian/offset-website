// Cloudflare Workers settings for running the site with OpenNext.
// The site's database is Cloudflare D1, bound as DB (unused until accounts arrive). Its ID isn't secret; any secrets go in the dashboard, never here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "offset-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "offset", "database_id": "c8712e60-f24e-4e79-a964-7f20b189a18a" }
  ],
  // Preview builds of pull requests share the same database; use a separate one before it holds real accounts.
  "previews": {
    "d1_databases": [{ "binding": "DB", "database_id": "c8712e60-f24e-4e79-a964-7f20b189a18a" }]
  },
  "observability": { "enabled": true }
}
